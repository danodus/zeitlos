# FPGA toolchain output (synth/pnr logs, bitstreams)
output/

# Generated SD-card image bundle
images/

# RISC-V cross-compiler output in each app dir (Makefile: -MD deps, objs,
# -S listing, objdump,.elf/.map/.bin; tracked *.bin data lives in sw/data/images/)
sw/**/*.o
sw/**/*.d
sw/**/*.asm
sw/**/*.dasm
sw/**/*.elf
sw/**/*.map
sw/**/*.bin
sw/bios/bios.hex

# Runtime-persisted selection state written by the net app
sw/apps/net/.*_selected

# Host-built test binaries (make test)
sw/apps/**/calc_test

# Generated by gen_ms_stdlib.py from sw/ext/ms/ms_stdlib.l (submodule)
sw/apps/repl/ms_stdlib.h
